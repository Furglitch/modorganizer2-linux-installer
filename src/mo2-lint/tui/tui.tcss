#dashhead, #dashcount {
    width: 100%;
    padding: 3 0;
    content-align: center middle;
}

#dashmenu {
    width: 100%;
    border: none;
    text-align: center;
    background: transparent;

    & > .option-list--option-highlighted {
        background: $secondary;
    }
}

#installprogress {
    width: 32;
    height: 23;
    margin: 1 0;
    border: $foreground;
}

#installgamelauncher, #installgamelist {
    padding: 1 3;
    margin: 2 3;
}

#installgamelist {
    height: 12;
}

#installgamenext, #installconfignext {
    width: 100%;
    height: 3;
}

#installconfigextender, #installconfigplugins, #installconfigthemes {
    padding: 1 3;
    margin: 2 3;
}

#installconfigextender {
    width: 100%;
    height: 5;
}

#installconfigplugins, #installconfigthemes {
    height: 8;
}

#manageinstancelist {
    width: 60%;
    height: 100%;
}

#manageinstanceinfo {
    width: 20%;
}

#manageinstancebuttons {
    width: 20%;
}

#manageinstanceupdate, #manageinstancepin, #manageinstanceuninstall{
    width: 100%;
}

ConfirmUninstall, TrashChoice {
    align: center middle;
}

#manageuninstallconfirm {
    width: 64;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#manageuninstallmessage {
    width: 100%;
    margin-bottom: 1;
}

#manageuninstallbuttons {
    width: 100%;
    align-horizontal: right;
}

#manageuninstallbuttons > Button {
    margin-left: 1;
}
