#dashhead, #dashcount {
    width: 100%;
    padding: 3 0;
    content-align: center middle;
}

#dashmenu {
    width: 100%;
    border: none;
    text-align: center;
    background: transparent;

    & > .option-list--option-highlighted {
        background: $secondary;
    }
}

#installprogress {
    width: 32;
    height: 23;
    margin: 1 0;
    border: $foreground;
}

#installgamelauncher, #installgamelist {
    padding: 1 3;
    margin: 2 3;
}

#installgamelist {
    height: 12;
}

#installgamenav, #installconfignav {
    width: 100%;
}

#installgameback, #installgamenext, #installconfigback, #installconfignext {
    width: 1fr;
    height: 3;
}

#installconfigextender, #installconfigplugins, #installconfigthemes {
    padding: 1 3;
    margin: 2 3;
}

#installconfigdirectory {
    padding: 0 3;
    margin: 2 3;
}

#installconfigextender {
    width: 100%;
    height: 5;
}

#installconfigplugins, #installconfigthemes {
    height: 8;
}

#manageinstancelist {
    width: 60%;
    height: 100%;
}

#manageinstanceinfo {
    width: 20%;
}

#manageinstancebuttons {
    width: 20%;
}

#manageinstanceupdate, #manageinstancepin, #manageinstanceuninstall, #manageinstanceback {
    width: 100%;
}

ConfirmUninstall, TrashChoice {
    align: center middle;
}

#manageuninstallconfirm {
    width: 64;
    padding: 1 2;
    border: thick $error;
    background: $surface;
}

#manageuninstallmessage {
    width: 100%;
    margin-bottom: 1;
}

#manageuninstallbuttons {
    width: 100%;
    align-horizontal: right;
}

#manageuninstallbuttons > Button {
    margin-left: 1;
}

PrefixSetup {
    align: center middle;
}

#installprefixdialog {
    width: 110;
    max-width: 95%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#installprefixmessage {
    width: 100%;
    margin-bottom: 1;
}

#installprefixbuttons {
    width: 100%;
    margin-top: 1;
    align-horizontal: right;
}

#installprefixbuttons > Button {
    margin-left: 1;
}

CommandProgress {
    align: center middle;
}

#commanddialog {
    width: 90%;
    height: 80%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#commandtitle {
    width: 100%;
    text-style: bold;
}

#commandstatus {
    width: 100%;
    margin: 1 0;
}

#commandprogress {
    width: 100%;
}

#commandprogress Bar {
    width: 1fr;
}

#commandlog {
    height: 1fr;
    margin: 1 0;
    border: round $foreground;
}

#commandbuttons {
    width: 100%;
    align-horizontal: right;
}

Choice {
    align: center middle;
}

#choicedialog {
    width: 80;
    max-width: 95%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#choicemessage {
    width: 100%;
    margin-bottom: 1;
}

#choicelist {
    max-height: 12;
}

#choicebuttons {
    width: 100%;
    margin-top: 1;
    align-horizontal: right;
}

#choicebuttons > Button {
    margin-left: 1;
}
