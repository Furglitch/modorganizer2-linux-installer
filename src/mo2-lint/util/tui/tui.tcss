#dashhead, #dashcount {
    width: 100%;
    padding: 3 0;
    content-align: center middle;
}

#dashmenu {
    width: 100%;
    border: none;
    text-align: center;
    background: transparent;

    & > .option-list--option-highlighted {
        background: $secondary;
    }
}

#installprogress {
    width: 32;
    height: 23;
    margin: 1 0;
    border: $foreground;
}

#installgamelauncher, #installgamelist {
    padding: 1 3;
    margin: 2 3;
}

#installgamelist {
    height: 12;
}

#installgamenext, #installconfignext {
    width: 100%;
    height: 3;
}

#installconfigextender, #installconfigplugins, #installconfigthemes {
    padding: 1 3;
    margin: 2 3;
}

#installconfigextender {
    width: 100%;
    height: 5;
}

#installconfigplugins, #installconfigthemes {
    height: 8;
}
